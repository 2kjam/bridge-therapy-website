ion-role=\"button\"\n  data-button-size=\"medium\"\n  data-button-type=\"primary\"\n  \n>\n  <a\n    href=\"/our-story\"\n    class=\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\"\n    data-sqsp-button\n    \n  >\n    Our Story\n  </a>\n  \n\n\n\n</div>\n\n    \n  \n    \n    \n      \n    \n  \n\n\n<style>\n  #block-yui_3_17_2_1_1546431535402_25942 {\n    --sqs-block-content-flex: 0;\n  }\n\n  \n  \n    \n      \n      \n    \n      \n      \n        \n      \n    \n  \n</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div></div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/f2f33f3e-f102-4470-9086-4fff458f9fa4_912/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/f2f33f3e-f102-4470-9086-4fff458f9fa4_912/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"yui_3_17_2_1_1546431535402_30575\" id=\"block-yui_3_17_2_1_1546431535402_30575\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p class=\"\" style=\"white-space:pre-wrap;\">Thank you for choosing Wood Christian Counseling and now The Bridge Therapeutic Services, to provide excellent care for you and your family. We look forward to serving you in 2019.</p><p style=\"text-align:right;white-space:pre-wrap;\" class=\"\">~ Erin Young, LCSW &amp; Jennifer Wood, LPC-S</p></div>\n\n\n  \n<style id=\"container-styles\">#block-yui_3_17_2_1_1546431535402_30575 {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n    