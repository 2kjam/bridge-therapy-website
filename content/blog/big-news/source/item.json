  "body": "<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-5c2cac65f950b760dd722b16\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/f2f33f3e-f102-4470-9086-4fff458f9fa4_912/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/f2f33f3e-f102-4470-9086-4fff458f9fa4_912/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"35a0b4425ae6dee1b822\" id=\"block-35a0b4425ae6dee1b822\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p class=\"\" style=\"white-space:pre-wrap;\">We are excited to announce that as of January 1, 2019 Wood Christian Counseling has changed its name and will now be The Bridge Therapeutic Services, PLLC. We will still provide everything you have loved about Wood Christian Counseling, and we are expanding our services to offer whole health care! Our office location and phone number will remain the same.</p></div>\n\n\n  \n<style id=\"container-styles\">#block-35a0b4425ae6dee1b822 {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-35a0b4425ae6dee1b822 .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-35a0b4425ae6dee1b822 {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-35a0b4425ae6dee1b822 {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-35a0b4425ae6dee1b822 {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-35a0b4425ae6dee1b822 {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-35a0b4425ae6dee1b822 .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"row sqs-row\"><div class=\"col sqs-col-8 span-8\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/f2f33f3e-f102-4470-9086-4fff458f9fa4_912/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/f2f33f3e-f102-4470-9086-4fff458f9fa4_912/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"yui_3_17_2_1_1546431535402_28540\" id=\"block-yui_3_17_2_1_1546431535402_28540\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p class=\"\" style=\"white-space:pre-wrap;\">Click OUR STORY to learn how we became The Bridge.</p></div>\n\n\n  \n<style id=\"container-styles\">#block-yui_3_17_2_1_1546431535402_28540 {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-yui_3_17_2_1_1546431535402_28540 .sqs-html-content {\n    \n    --tweak-text-block-paddi