{
  "name": "the-bridge-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib scripts tests next.config.ts playwright.config.ts playwright.blog.config.ts playwright.navigation.config.ts eslint.config.mjs",
    "check": "tsc --noEmit && node scripts/check-site.mjs",
    "test:e2e": "playwright test",
    "test:navigation": "playwright test --config=playwright.navigation.config.ts",
    "test:blog": "node --test tests/blog.test.mjs tests/blog-collection.test.mjs && playwright test --config=playwright.blog.config.ts",
    "dev:legacy": "node legacy/preview-server.cjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "parse5": "8.0.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
